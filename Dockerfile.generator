# Code generated by our bespoke codegen `go-sdk-generator` (0.47.0).

FROM golang:1.26.5 as build

WORKDIR /build
COPY generator generator

COPY cli cli
WORKDIR /build/cli
COPY scripts /tmp/scripts
RUN --mount=type=secret,id=build-secrets . /run/secrets/build-secrets &&\
    chmod -R +x /tmp/scripts/ &&\
    mv /tmp/scripts/* /usr/local/bin/ &&\
    rm -r /tmp/scripts &&\
    setup_github.sh ${GITHUB_TOKEN} &&\
    go mod download

RUN CGO_ENABLED=0 go build -o /output/generator

FROM alpine:3.24.2

RUN addgroup -S app && adduser -S -G app app

# Install go binary
COPY --from=build --chown=app:app /output/generator /usr/local/bin/generator

USER app
ENTRYPOINT ["generator"]
