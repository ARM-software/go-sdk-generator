# Code generated by our bespoke codegen `go-sdk-generator` (0.24.0).

FROM golang:1.26.1 as build

WORKDIR /build
ADD generator generator

ADD cli cli
WORKDIR /build/cli
COPY scripts /tmp/scripts
RUN --mount=type=secret,id=build-secrets . /run/secrets/build-secrets &&\
    chmod -R +x /tmp/scripts/ &&\
    mv /tmp/scripts/* /usr/local/bin/ &&\
    rm -r /tmp/scripts &&\
    setup_github.sh ${GITHUB_TOKEN} &&\
    go mod download

RUN CGO_ENABLED=0 go build -o /output/generator

FROM alpine:3.23.3
# Install go binary
COPY --from=build /output/generator /usr/local/bin/generator

ENTRYPOINT ["generator"]
