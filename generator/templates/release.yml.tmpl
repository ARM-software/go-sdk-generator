name: GitHub Release

env:
  go_version: "{{ .TargetedGoVersion }}"

on:
  workflow_dispatch:
    inputs:
      release_type:
        description:
          "Enter type of release to perform (i.e. development, beta, release):"
        required: true

jobs:
  release:
    name: Release
    uses: Arm-Debug/OTG-Services-Workflows/.github/workflows/release.yml@latest
    secrets:
      inherit
    with:
      release_type: ${{ "{{" }} inputs.release_type }}
      save-outputs-as-artefact: {{ .Specification.PackageName }}-package
      {{ if .Specification.ReleaseToArtifactory -}}
      release_to_artifactory: true
      {{ end }}
