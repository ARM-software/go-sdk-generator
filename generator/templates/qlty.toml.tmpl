# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}). DO NOT EDIT

config_version = "0"

exclude_patterns = [
"**/node_modules/**",
"**/vendor/**",
"config/**",
"db/**",
"dist/**",
"features/**",
"docs/**",
"changes/**",
"**/node_modules/**",
"script/**",
"**/spec/**",
"**/mock/**",
"**/mocks/**",
"**/test/**",
"**/tests/**",
"**/vendor/**",
"**/*.gen*",
"**/gen/**",
{{- range .GeneratedFiles }}
"{{ . }}",
{{- end }}
]

test_patterns = ["**/*_test.go", "**/spec/**"]

[smells.return_statements]
enabled = false

[[source]]
name = "default"
default = true

[[plugin]]
name = "actionlint"

[[plugin]]
name = "checkov"
version = "3.2.49"

[[plugin]]
name = "markdownlint"
version = "0.31.1"

[[plugin]]
name = "osv-scanner"

[[plugin]]
name = "prettier"
version = "2.8.4"

[[plugin]]
name = "ripgrep"

[[plugin]]
name = "shellcheck"
version = "0.9.0"

[[plugin]]
name = "shfmt"

[[plugin]]
name = "trivy"

[[plugin]]
name = "trufflehog"

[[plugin]]
name = "yamllint"

# Generated GitHub Action metadata uses long descriptions and shell commands.
[[triage]]
match.rules = ["yamllint:line-length"]
match.file_patterns = ["actions/**/*.yml", "actions/**/*.yaml", ".github/workflows/*.yml", ".github/workflows/*.yaml", ".goreleaser.yml", ".pre-commit-config.yaml"]
set.ignored = true

# Prettier is the Markdown formatting authority; keep Markdownlint's content rules.
[[triage]]
match.rules = ["markdownlint:fmt"]
set.ignored = true

# README formatting is maintained outside Qlty.
[[triage]]
match.plugins = ["prettier"]
match.file_patterns = ["README.md", "**/README.md"]
set.ignored = true
