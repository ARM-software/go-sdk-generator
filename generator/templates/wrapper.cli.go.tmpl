	envVars = collection.Map(slices.Collect(maps.Keys(flattenedCfg)), func(key string) environmentUtils.IEnvironmentVariable {
		return environmentUtils.NewEnvironmentVariable(key, fmt.Sprintf("%v", flattenedCfg[key]))
