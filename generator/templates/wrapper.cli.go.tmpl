func newRichLogger(loggerSource string) (logs.Loggers, error) {
	richLogger := richlog.New(richlog.WithPrefix(loggerSource), richlog.WithTimestamp())
	return &RichLoggerAdapter{logger: richLogger}, nil
}

func resolveBaseLogger(loggerType string, loggerFile string, loggerSource string) (logs.Loggers, error) {
	selectedLogger := normaliseRuntimeOption(loggerType, config.{{ $runtimeEnumPrefix }}LoggerConsole.String())

	switch selectedLogger {
	case config.{{ $runtimeEnumPrefix }}LoggerConsole.String():
		return logs.NewStdLogger(loggerSource)
	case config.{{ $runtimeEnumPrefix }}LoggerRich.String():
		return newRichLogger(loggerSource)
	case config.{{ $runtimeEnumPrefix }}LoggerFile.String():
		return logs.NewFileOnlyLogger(loggerFile, loggerSource)
	case config.{{ $runtimeEnumPrefix }}LoggerNone.String():
		return logs.NewNoopLogger(loggerSource)
	case config.{{ $runtimeEnumPrefix }}LoggerCustom.String():
		if reflection.IsEmpty(CustomLoggerDefinition) {
			return nil, commonerrors.New(commonerrors.ErrNoLogger, "logger is set to custom but no custom logger has been registered during initialisation")
		}
		if err := CustomLoggerDefinition.SetLogSource(loggerSource); err != nil {
			return nil, commonerrors.WrapError(commonerrors.ErrInvalid, err, "failed setting the custom logger source")
		}
		if err := CustomLoggerDefinition.SetLoggerSource(loggerSource); err != nil {
			return nil, commonerrors.WrapError(commonerrors.ErrInvalid, err, "failed setting the custom logger source")
		}
		return CustomLoggerDefinition, nil
	default:
		return nil, commonerrors.Newf(commonerrors.ErrUnsupported, "unsupported logger value %q", loggerType)
	}
}

func resolveAnnotationLogger(baseLogger logs.Loggers, annotationType string) (annotations.IAnnotationLogger, error) {
	if reflection.IsEmpty(baseLogger) {
		return nil, commonerrors.ErrNoLogger
	}

	selectedAnnotation := normaliseRuntimeOption(annotationType, config.{{ $runtimeEnumPrefix }}AnnotationNone.String())
	switch selectedAnnotation {
	case config.{{ $runtimeEnumPrefix }}AnnotationNone.String():
		annotationLogger, err := annotations.NewLogger(baseLogger, PlainAnnotationFormatter{})
		if err != nil {
			return nil, commonerrors.WrapError(commonerrors.ErrUnexpected, err, "failed initialising the plain annotation logger")
		}
		return &AnnotationAwareLogger{Loggers: baseLogger, annotationLogger: annotationLogger}, nil
	case config.{{ $runtimeEnumPrefix }}AnnotationGithub.String():
		annotationLogger, err := annotations.NewGitHubLogger(baseLogger)
		if err != nil {
			return nil, commonerrors.WrapError(commonerrors.ErrUnexpected, err, "failed initialising the GitHub annotation logger")
		}
		return &AnnotationAwareLogger{Loggers: baseLogger, annotationLogger: annotationLogger}, nil
	default:
		return nil, commonerrors.Newf(commonerrors.ErrUnsupported, "unsupported annotation value %q", annotationType)
	}
}

// ResolveRuntimeLoggerAndAnnotations resolves the generated CLI logger and
// annotation behaviour from the selected runtime configuration.
func ResolveRuntimeLoggerAndAnnotations(loggerType string, loggerFile string, annotationType string, loggerSource string) (logs.Loggers, annotations.IAnnotationLogger, error) {
	baseLogger, err := resolveBaseLogger(loggerType, loggerFile, loggerSource)
	if err != nil {
		return nil, nil, err
	}

	annotationLogger, err := resolveAnnotationLogger(baseLogger, annotationType)
	if err != nil {
		return nil, nil, err
	}

	return baseLogger, annotationLogger, nil
}

