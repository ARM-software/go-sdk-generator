// SummaryLoggerFactory creates a summary logger for any summary-enabled command.
// The option is typed as `any` because each generated command has its own enum type,
// and this shared factory needs to accept all of them. This relies on every generated
// summary enum having the same definition and order (`file`, `github`, `output`), so
// corresponding enum values remain interchangeable across summary enum types.
func SummaryLoggerFactory(option any, filepath string, logger logs.Loggers) summary.ISummaryLogger {
	noopLogger, _ := logs.NewNoopLogger("summary")
	var summaryLogger summary.ISummaryLogger = summary.NewSummaryLogger(noopLogger)
	// Each summary-capable command has its own generated enum type, but they all share
	// the same ordered values, so this switch can match whichever typed enum the wrapper
	// already parsed.
	switch option {
	{{ range .Specification.CommandLineCommands.Functions -}}
	{{ $functionName:= .Name  | toPascal -}}
	{{ if usesSummary . $.Specification.CommandLineCommands -}}
	case config.{{ $functionName }}SummaryOutput:
		summaryLogger = summary.NewSummaryLogger(logger)
	case config.{{ $functionName }}SummaryGithub:
		if githubSummaryLogger, err := summary.NewGitHubSummaryLogger("summary"); err == nil {
			summaryLogger = githubSummaryLogger
		}
	case config.{{ $functionName }}SummaryFile:
		if fileSummaryLogger, err := summary.NewFileSummaryLogger(filepath, "summary"); err == nil {
			summaryLogger = fileSummaryLogger
		}
	{{ end -}}
	{{ end -}}
	}

	return summaryLogger
}

