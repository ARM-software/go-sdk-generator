# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

name: CI

# Cancel in-progress jobs or runs for the current workflow
concurrency:
  group: ${{ "{{" }} github.repository }}-${{ "{{" }} github.workflow }}-${{ "{{" }} github.head_ref || github.ref }}
  cancel-in-progress: true

on:
  push:
    branches: [main]
    tags-ignore:
      - "**"
  pull_request:
    branches:
      - main

env:
  go_version: "{{ .TargetedGoVersion }}"

jobs:
  library:
    name: Run library CI
    uses: Arm-Debug/OTG-Services-Workflows/.github/workflows/library.yml@latest
    secrets: inherit
    with:
      branch: ${{ "{{" }} github.head_ref || github.ref }}
      dockerfile: Dockerfile.{{ .Specification.MainModule }}
      go_module: {{ .Specification.MainModule }}
      run-go-generate: true
{{- if .Specification.CiExtraPackages }}
      extra-packages: {{ range $i, $package := .Specification.CiExtraPackages }}{{ if $i }}, {{ end }}{{ $package }}{{ end }}
{{- end }}
{{- if .Specification.CommandLineCommands }}
  cli:
    name: Build CLI to ensure it compiles
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version: ${{ "{{" }} env.go_version }}

{{- if not .Specification.Public }}
      - name: Configure access to private dependencies
        run: |
          {{ githubAuthenticationForGoPrivateDependencies .Specification }}
        env:
          GIT_SECRET: ${{ "{{" }} secrets.GIT_SECRET }}
{{- end }}

      - name: Build CLI
        working-directory: ./{{ .Specification.CommandLineCommands.Package }}
        run: go build ./...

{{- if .InstallAction }}
  dogfood-action:
    name: Dogfood Action
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version: ${{ "{{" }} env.go_version }}

{{- if not .Specification.Public }}
      - name: Configure access to private dependencies
        run: |
          {{ githubAuthenticationForGoPrivateDependencies .Specification }}
        env:
          GIT_SECRET: ${{ "{{" }} secrets.GIT_SECRET }}
{{- end }}

      - name: Detect whether published releases exist
        id: published-releases
        env:
          GH_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN || github.token }}
        run: |
          has_release="$(gh api "repos/${{ "{{" }} github.repository }}/releases?per_page=1" --jq 'length > 0')"
          echo "has-release=${has_release}" >> "$GITHUB_OUTPUT"

      - name: Run local action against published release
        if: steps.published-releases.outputs.has-release == 'true'
        id: install-published-release
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}

      - name: Verify published release cmd output
        if: steps.published-releases.outputs.has-release == 'true'
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-published-release.outputs.cmd }}"
          test -n "$cmd"

      - name: Skip published release install check when no releases exist
        if: steps.published-releases.outputs.has-release != 'true'
        run: echo "No published GitHub release exists yet; skipping published release install check."

      - name: Run local action at current commit SHA
        id: install-current-sha
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}
          action-ref: ${{ "{{" }} github.sha }}

      - name: Verify current commit SHA cmd output
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-current-sha.outputs.cmd }}"
          test -n "$cmd"

      - name: Run local action and force source build
        id: install-force-source
        env:
          FORCE_SOURCE_BUILD: "true"
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}

      - name: Verify forced source build cmd output
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-force-source.outputs.cmd }}"
          test -n "$cmd"
{{- end }}
{{- end }}
