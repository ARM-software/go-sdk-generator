# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

name: CI

# Cancel in-progress jobs or runs for the current workflow
concurrency:
  group: ${{ "{{" }} github.repository }}-${{ "{{" }} github.workflow }}-${{ "{{" }} inputs.branch || github.head_ref || github.ref }}
  cancel-in-progress: true

on:
  push:
    branches: [ main ]
    tags-ignore:
      - '**'
  pull_request:
    branches: 
      - main

env:
  go_version: "{{ .TargetedGoVersion }}"

jobs:
  library:
    name: Run library CI
    uses: Arm-Debug/OTG-Services-Workflows/.github/workflows/library.yml@latest
    secrets:
      inherit
    with:
      branch: ${{ "{{" }} github.head_ref || github.ref }}
      dockerfile: Dockerfile.{{ .Specification.MainModule }}
      go_module: {{ .Specification.MainModule }}
{{- if .Specification.CiExtraPackages }}
      extra-packages: {{ range $i, $package := .Specification.CiExtraPackages }}{{ if $i }}, {{ end }}{{ $package }}{{ end }}
{{- end }}
{{- if .Specification.CommandLineCommands }}
  cli:
    name: Build CLI to ensure it compiles
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.go_version }}

      - name: Configure Git with secret
        run: |
          git config --global url."https://${{ "{{" }} secrets.GIT_SECRET }}:x-oauth-basic@github.com/Arm-Debug".insteadOf "https://github.com/Arm-Debug"
        env:
          GIT_SECRET: ${{ "{{" }} secrets.GIT_SECRET }}

      - name: Build CLI
        working-directory: ./cli
        run: go build ./...

{{- if not .Specification.CommandLineCommands.NoAction }}
  dogfood-action:
    name: Dogfood Action
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run local action
        uses: ./{{ normaliseActionName .Specification.PackageName }}
        with:
          args: --version

      - name: Run unpublished action and binary
        uses: ./{{ normaliseActionName .Specification.PackageName }}
        with:
          repo: ${{ "{{" }} github.repository }}
          action-ref: ${{ "{{" }} github.sha }}
          args: --version
{{- end }}
{{- end }}
