package types


import (
	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/go-ozzo/ozzo-validation/v4/is"
	validation "github.com/go-ozzo/ozzo-validation/v4"

    {{ if .Specification.ExtraImports -}}
	{{ range .Specification.ExtraImports -}}
	{{ .ImportRef }} "{{ .ImportUrl }}"
	{{ end -}}
	{{ end -}}
)
{{ if .Specification.ExtraImports -}}
import (
	{{ range .Specification.ExtraImports -}}
	{{ .ImportRef }} "{{ .ImportUrl }}"
	{{ end -}}
)
{{ end -}}

{{ range .Specification.AdditionalTypes }}
// {{ .Description }}
type {{ .Name }} struct {
{{ range .Fields -}}
	// {{ .description }}
	{{ .name }} {{ .lang_type | convertLangType }} `json:"{{ .json_tag }}" mapstructure:"{{ .mapstructure_tag }}"`
	{{ end }}	
}

func (cfg *{{ .Name }}) Validate() error {
	err := configUtils.ValidateEmbedded(cfg)
	if err != nil {
		return err
	}

	return validation.ValidateStruct(cfg,
	{{ range .Fields -}}
	{{ $validation := .lang_type | validationLangType -}}
    {{ if .required }}
        validation.Field(&cfg.{{ .name }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }}),
    {{ else if .condition -}}
        validation.Field(&cfg.{{ .name }}, validation.When(cfg.{{ .condition }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }})),
    {{ else if $validation -}}
        validation.Field(&cfg.{{ .name }}{{ $validation }}),
	{{ end }}
	{{ end }}
	)
}

func Default{{ .Name }}() *{{ .Name }} {
	return &{{ .Name }}{
	{{ range .Fields -}}
	{{ if .default_value -}}
	{{ .name }}: {{ defaultValue .lang_type .default_value }},
	{{ end -}}
	{{ end -}}
	}
}
{{ end }}

