# This EditorConfig (https://editorconfig.org) has been generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).  DO NOT EDIT
root = true

# --------------------------------------------------------------------
# Global defaults
# --------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# --------------------------------------------------------------------
# Go files (gofmt enforces tabs)
# --------------------------------------------------------------------
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# --------------------------------------------------------------------
# YAML files
# --------------------------------------------------------------------
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# --------------------------------------------------------------------
# JSON and JavaScript/TypeScript files
# --------------------------------------------------------------------
[*.{json,js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# --------------------------------------------------------------------
# TOML files (go.mod, config files, etc.)
# --------------------------------------------------------------------
[*.toml]
indent_style = space
indent_size = 2

# --------------------------------------------------------------------
# Markdown files
# Keep trailing whitespace (used for hard line breaks)
# --------------------------------------------------------------------
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# --------------------------------------------------------------------
# Shell / Bash scripts
# --------------------------------------------------------------------
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Common script/config files without extensions
[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 2
