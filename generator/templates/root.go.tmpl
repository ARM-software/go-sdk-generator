package cmd

import (
	"embed"
	"os"

	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/spf13/cobra"
	"github.com/spf13/viper"
)

const (
	app = "{{ .Specification.CommandLineCommands.RootEnvironmentVar }}"
	{{ range .Specification.CommandLineCommands.Functions -}}
	{{ range .Configuration -}}
	{{ if isValidArgType .LangType }}
	{{ if .IsRoot -}}
	{{ if notSeenRootCmd .Name -}}
	{{ $mapstructure:= .MapstructureTag -}}
	{{ if .Bindings -}}
	{{ range .Bindings -}}
	root{{ .Name }}Arg = "{{ $mapstructure | replaceUnderscores }}-{{ .MapstructureTag | replaceUnderscores }}"{{ if ignoreLinting .Name -}} //nolint:gosec // not a secret{{ end -}}
	{{ end -}}
	{{ else -}}
	root{{ .Name }}Arg = "{{ .MapstructureTag | replaceUnderscores }}"{{ if ignoreLinting .Name -}} //nolint:gosec // not a secret{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ resetNotSeenRootCmd -}}
)

var (
	//go:embed module.properties
	embeddedFS   embed.FS
	viperSession = viper.New()
)

// rootCmd represents the base command when called without any subcommands
var rootCmd = &cobra.Command{
	Use:   "{{ .Specification.CommandLineCommands.Binary }}",
	Short: "{{ .Specification.CommandLineCommands.Description }}",
	Long: "{{ .Specification.CommandLineCommands.Description }}",
}

func Execute() {
	err := rootCmd.Execute()
	if err != nil {
		os.Exit(1)
	}
}

func init() {
	{{ range .Specification.CommandLineCommands.Functions -}}
	{{ range .Configuration -}}
	{{ if .IsRoot -}}
	{{ if isValidArgType .LangType }}
	{{ if notSeenRootCmd .Name -}}
	{{ $mapstructure:= .MapstructureTag -}}
	{{ if .Bindings -}}
	{{ range .Bindings -}}
	rootCmd.PersistentFlags().{{ .LangType | argFlagtype }}(root{{ .Name }}Arg, {{ .LangType | zero }}, "{{ .Description }}")
	_ = configUtils.BindFlagToEnv(viperSession, app, fmt.Sprintf("%s_{{ $mapstructure }}_{{ .MapstructureTag }}", app), rootCmd.PersistentFlags().Lookup(root{{ .Name }}Arg))
	{{ end -}}
	{{ else -}}
	rootCmd.PersistentFlags().{{ .LangType | argFlagtype }}(root{{ .Name }}Arg, {{ .LangType | zero }}, "{{ .Description }}")
	_ = configUtils.BindFlagToEnv(viperSession, app, "{{ .MapstructureTag }}", rootCmd.PersistentFlags().Lookup(root{{ .Name }}Arg))
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end }}
	{{ resetNotSeenRootCmd -}}
}
