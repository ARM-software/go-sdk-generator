{{ range .Specification.ExtraValidTypes -}}
{{ addExtraValidType . -}}
{{ end -}}
{{ end -}}
package cmd

import (
	"embed"
	"os"

	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/ARM-software/golang-utils/utils/commonerrors"
	"github.com/ARM-software/golang-utils/utils/semver"
	"github.com/charmbracelet/fang"
	"github.com/spf13/cobra"
	"github.com/spf13/viper"

	"github.com/Arm-Debug/{{ .Specification.PackageName }}/cli/cmd/config"
)

{{- if .RootArgConsts }}
const (
	{{- range .RootArgConsts }}
	{{ .Name }} = "{{ .Value }}"{{ if .NoLint }} //nolint:gosec // not a secret {{ end }}
	{{- end }}
)
{{- end }}

var (
	//go:embed module.properties
	embeddedFS   embed.FS
	viperSession = viper.New()
)

// rootCmd represents the base command when called without any subcommands
var rootCmd = &cobra.Command{
	Use:   "{{ .Specification.CommandLineCommands.Binary }}",
	Short: "{{ .Specification.CommandLineCommands.Description }}",
	Long: "{{ .Specification.CommandLineCommands.Description }}",
}

func Execute() {
	ctx := context.Background()

	cliVersion, err := semver.DetermineEmbeddedVersion(ctx, &embeddedFS, nil)
	if err != nil {
		// This is for completeness but it is impossible at runtime since we need a valid module.properties in this location to release the package
		cliVersion = "unknown"
	}

	if err := fang.Execute(ctx, rootCmd, fang.WithVersion(cliVersion)); err != nil {
		{{ if .Specification.CommandLineCommands.InterruptExitCode }}
		if commonerrors.Any(err, commonerrors.ErrInterrupted) {
			os.Exit({{ .Specification.CommandLineCommands.InterruptExitCode }})
		}
		{{ end }}
		os.Exit(1)
	}
}

func init() {
	{{- range .RootFlagRegistrations }}
	{{ .FlagLine }}
	{{- end }}

	{{ range .RootEnvVarBindings }}
	{{- if gt (len .FlagBindings) 1 }}
	_ = configUtils.BindFlagsToEnv(viperSession, config.App, "{{ .EnvVar }}", {{- range $i, $flag := .FlagBindings -}}{{ if $i }}, {{ end }}{{ $flag }}{{- end -}})
	{{- else }}
	_ = configUtils.BindFlagToEnv(viperSession, config.App, "{{ .EnvVar }}", {{ index .FlagBindings 0 }})
	{{- end }}
	{{- end }}
}
