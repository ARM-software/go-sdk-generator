#!/bin/bash

# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

cd {{ .Specification.MainModule }} || exit 1
go mod tidy
go generate ./...
cd .. || exit 1

cd {{ .Specification.CommandLineCommands.Package }} || exit 1
go build -o {{ .Specification.CommandLineCommands.Binary }} .
mkdir -p ../.manpages
./{{ .Specification.CommandLineCommands.Binary }} man >../.manpages/{{ .Specification.CommandLineCommands.Binary }}.1
{{ if .Specification.Public }}
cd .. || exit 1
mkdir -p .sboms
if command -v cd-generate-spdx >/dev/null 2>&1; then
  cd-generate-spdx -o .sboms -v
else
  echo "cd-generate-spdx not found; skipping CDS SPDX generation"
fi
{{ end }}
