# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

# OCI runtime image for running {{ .Specification.CommandLineCommands.Binary }} from released Alpine packages in CI and other container-first workflows.
FROM alpine:3.22.1

LABEL org.opencontainers.image.source={{ .OCI.SourceURL | quote }}
LABEL org.opencontainers.image.title={{ .OCI.Title | quote }}
LABEL org.opencontainers.image.description={{ .OCI.Description | quote }}
LABEL org.opencontainers.image.documentation={{ .OCI.Documentation | quote }}
LABEL org.opencontainers.image.licenses={{ .OCI.Licences | quote }}

ARG TARGETPLATFORM

COPY $TARGETPLATFORM/*.apk /tmp/

RUN apk add --allow-untrusted --no-cache jq yq curl /tmp/*.apk && \
    rm -f /tmp/*.apk

ENTRYPOINT ["{{ .Specification.CommandLineCommands.Binary }}"]
