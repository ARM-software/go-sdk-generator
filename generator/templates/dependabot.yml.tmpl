# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

version: 2
registries:
  github:
    type: git
    url: https://github.com
    username: x-access-token
    password: ${{ "{{" }} secrets.GIT_SECRET }}
updates:
- package-ecosystem: gomod
  directory: "/{{ .Specification.MainModule }}"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
  registries:
    - github
  groups:
    golang-utils:
      applies-to: version-updates
      patterns:
        - "github.com/ARM-software/golang-utils/utils/*"
    embedded-development-services-client-utils:
      applies-to: version-updates
      patterns:
        - "github.com/ARM-software/embedded-development-services-client-utils/utils"
        - "github.com/ARM-software/embedded-development-services-client-utils/utils/*"
{{ if .Specification.CommandLineCommands -}}
- package-ecosystem: gomod
  directory: "/{{ .Specification.CommandLineCommands.Package }}"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
  registries:
    - github
  groups:
    golang-utils:
      applies-to: version-updates
      patterns:
        - "github.com/ARM-software/golang-utils/utils/*"
    embedded-development-services-client-utils:
      applies-to: version-updates
      patterns:
        - "github.com/ARM-software/embedded-development-services-client-utils/utils"
        - "github.com/ARM-software/embedded-development-services-client-utils/utils/*"
{{ end -}}
- package-ecosystem: github-actions
  directory: "/"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
  registries:
    - github
  groups:
    actions-security:
      applies-to: security-updates
      patterns:
        - "*"
- package-ecosystem: docker
  directory: "/"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
