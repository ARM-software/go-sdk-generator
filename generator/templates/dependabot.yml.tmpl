version: 2
registries:
  github:
    type: git
    url: https://github.com
    username: x-access-token
    password: ${{ "{{" }}secrets.GIT_SECRET}}
updates:
- package-ecosystem: gomod
  directory: "/{{ .Specification.MainModule }}"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
  registries:
    - github
{{ if .Specification.CommandLineCommands -}}
- package-ecosystem: gomod
  directory: "/cli"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
  registries:
    - github
{{ end -}}
- package-ecosystem: docker
  directory: "/"
  schedule:
    interval: daily
    timezone: Europe/London
  open-pull-requests-limit: 10
  rebase-strategy: disabled
