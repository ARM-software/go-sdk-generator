# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

name: Licensing

on:
  workflow_dispatch:
  schedule:
    - cron: '17 3 * * *'

permissions:
  contents: write
  pull-requests: write

jobs:
  licensing:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
          token: ${{ "{{" }} secrets.GIT_SECRET || github.token }}
      - uses: actions/setup-python@v7
        with:
          python-version: '3.11'
      - name: Install CDS
        run: python -m pip install --upgrade 'continuous-delivery-scripts>=4.8.0'
      - name: Update copyright headers
        id: licensing
        shell: bash
        run: |
          set -euo pipefail
          cd-license-files
          if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
            if ! git grep -q -F ':robot: Update copyright headers' -- 'changes/*.misc'; then
              cd-create-news-file --type misc ':robot: Update copyright headers'
            fi
            echo 'changed=true' >> "$GITHUB_OUTPUT"
          fi
      - name: Create or update licensing PR
        if: ${{ "{{" }} steps.licensing.outputs.changed == 'true' }}
        uses: peter-evans/create-pull-request@v8
        with:
          token: ${{ "{{" }} secrets.GIT_SECRET || github.token }}
          branch: automation/licensing
          base: ${{ "{{" }} github.event.repository.default_branch }}
          title: ':robot: Chores: licensing'
          commit-message: ':robot: Chores: licensing'
          body: |
            Update copyright headers with `cd-license-files` and add a misc news fragment.
