## Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}). DO NOT EDIT

name: {{ .GeneratedAction.Name }}
description: {{ .GeneratedAction.Description }}

outputs:
  cmd:
    description: A reference to the `{{ .Specification.CommandLineCommands.Binary }}` command.
    value: ${{ "{{" }} steps.install-and-run.outputs.cmd }}

inputs:
  action-repo:
    description: Repository to download releases from. Defaults to the repository providing this action.
    required: false
    default: ""
  action-ref:
    description: Override the GitHub Action ref used to resolve the release or source revision.
    required: false
    default: ""
  github-token:
    description: "The GitHub token to use to fetch releases or source refs for the tools. (Note: github.token may not have the required permissions to access the action repository)"
    required: false # only needed for fetching releases or private source refs
    default: ""
  workdir:
    description: Working directory where the CLI is run. If later workflow steps need to call the installed tool, use the `cmd` output rather than inferring its location from this directory.
    required: false
    default: .
{{- range .GeneratedAction.Inputs }}
  {{ .Name }}:
    description: {{ .Description | quote }}
    required: {{ .Required }}
{{- if not .Required }}
    default: {{ .Default | quote }}
{{- end }}
{{- end }}

runs:
  using: composite
  steps:
    - name: Determine whether the action should use an unpublished ref
      id: installation-mode
      shell: bash
      env:
        ACTION_REF: ${{ "{{" }} inputs.action-ref || github.action_ref }}
      run: |
        ref="${ACTION_REF:-}"
        source_build=false
        force_source_build="${FORCE_SOURCE_BUILD:-}"

        case "${force_source_build:-}" in
          [Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]|[Yy]|[Oo][Nn])
            source_build=true
            ;;
        esac

        if [[ "$source_build" != "true" && -n "$ref" ]]; then
          if [[ "$ref" =~ ^refs/heads/ ]]; then
            source_build=true
          elif [[ "$ref" =~ ^[0-9a-f]{7,40}$ ]]; then
            source_build=true
          elif [[ ! "$ref" =~ ^refs/tags/latest$ && ! "$ref" =~ ^latest$ && ! "$ref" =~ ^refs/tags/v?[0-9]+(\.[0-9]+){0,2}$ && ! "$ref" =~ ^v?[0-9]+(\.[0-9]+){0,2}$ ]]; then
            source_build=true
          fi
        fi

        printf 'source-build=%s\n' "$source_build" >> "$GITHUB_OUTPUT"

    - name: Resolve action source inputs
      id: action-source
      shell: bash
      env:
        INPUT_ACTION_REPO: ${{ "{{" }} inputs.action-repo }}
        DEFAULT_ACTION_REPOSITORY: {{ repositoryLocationOnGitHub .Specification }}
        ACTION_REF: ${{ "{{" }} inputs.action-ref || github.action_ref }}
      run: |
        resolved_repo="${INPUT_ACTION_REPO:-}"
        resolved_ref="${ACTION_REF:-}"
        force_source_build="${FORCE_SOURCE_BUILD:-}"

        if [[ -z "$resolved_repo" ]]; then
          resolved_repo="${DEFAULT_ACTION_REPOSITORY}"
        fi

        case "${force_source_build:-}" in
          [Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]|[Yy]|[Oo][Nn])
            if [[ -z "$resolved_ref" ]]; then
              resolved_ref="${GITHUB_SHA:-}"
            fi
            ;;
        esac

        fetch_ref="$resolved_ref"
        if [[ -n "$resolved_ref" && ! "$resolved_ref" =~ ^refs/ && ! "$resolved_ref" =~ ^[0-9a-f]{7,40}$ ]]; then
          if [[ "$resolved_ref" =~ ^v ]]; then
            fetch_ref="refs/tags/${resolved_ref}"
          else
            fetch_ref="refs/heads/${resolved_ref}"
          fi
        fi

        printf 'repository=%s\n' "$resolved_repo" >> "$GITHUB_OUTPUT"
        printf 'ref=%s\n' "$resolved_ref" >> "$GITHUB_OUTPUT"
        printf 'fetch-ref=%s\n' "$fetch_ref" >> "$GITHUB_OUTPUT"

    - name: Check out source to build the unpublished binary
      if: steps.installation-mode.outputs.source-build == 'true'
      uses: actions/checkout@v7
      with:
        repository: ${{ "{{" }} steps.action-source.outputs.repository }}
        ref: ${{ "{{" }} steps.action-source.outputs.fetch-ref }}
        path: .action-source
        token: ${{ "{{" }} inputs.github-token || github.token }}

    - name: Set up Go to build the action from source
      if: steps.installation-mode.outputs.source-build == 'true'
      uses: actions/setup-go@v7
      with:
        go-version-file: ${{ "{{" }} github.workspace }}/.action-source/{{ .Specification.CommandLineCommands.Package }}/go.mod

{{- if not .GeneratedAction.InstallOnly }}
    - name: Set up Go to run the CLI
      if: steps.installation-mode.outputs.source-build != 'true'
      uses: actions/setup-go@v7
      with:
        go-version: {{ .TargetedGoVersion }}

    - name: Install and run {{ .Specification.CommandLineCommands.Binary }}
{{- else }}
    - name: Install {{ .Specification.CommandLineCommands.Binary }}
{{- end }}
      id: install-and-run
      shell: bash
      env:
        ACTION_REF: ${{ "{{" }} steps.action-source.outputs.ref }}
        GH_TOKEN: ${{ "{{" }} inputs.github-token || github.token }}
        INPUT_ACTION_REPO: ${{ "{{" }} inputs.action-repo }}
        DEFAULT_REPO: ${{ "{{" }} steps.action-source.outputs.repository }}
        INPUT_INSTALL_ONLY: {{ if .GeneratedAction.InstallOnly }}"true"{{ else }}"false"{{ end }}
        INPUT_WORKDIR: ${{ "{{" }} inputs.workdir }}
        INPUT_SUBCOMMAND: {{ .GeneratedAction.Subcommand | quote }}
{{- if .GeneratedAction.Inputs }}
        INPUT_ACTION_INPUTS_SPEC: |-
{{- range .GeneratedAction.Inputs }}
          ACTION_INPUT_{{ .EnvName }}|{{ .FlagName }}|{{ .IsBoolean }}|{{ .IsOperand }}
{{- end }}
{{- end }}
        SOURCE_CHECKOUT_DIR: ${{ "{{" }} github.workspace }}/.action-source
{{- range .GeneratedAction.Inputs }}
        ACTION_INPUT_{{ .EnvName }}: ${{ "{{" }} inputs.{{ .Name }} }}
{{- end }}
      run: |
        bash "$GITHUB_ACTION_PATH/../_shared/install-and-run.sh"
