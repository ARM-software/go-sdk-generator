#!/usr/bin/env bash

# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}). DO NOT EDIT

set -euo pipefail

repo="${INPUT_REPO:-}"
if [[ -z "$repo" ]]; then
  repo="${DEFAULT_REPO:-}"
fi
if [[ -z "$repo" ]]; then
  repo="Arm-Debug/{{ .Specification.PackageName }}"
fi

package_name="{{ .Specification.PackageName }}"
binary_name="{{ .Specification.CommandLineCommands.Binary }}"

args="${INPUT_ARGS:-}"
install_only="${INPUT_INSTALL_ONLY:-false}"
workdir_input="${INPUT_WORKDIR:-.}"
action_ref="${ACTION_REF:-}"

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

log() {
  printf '%s\n' "$*" >&2
}

warn_no_release() {
  log "${package_name} has not been officially released yet. Skipping installation."
}

is_true() {
  # Composite action inputs arrive as strings, so normalise common truthy forms.
  case "${1,,}" in
    true|1|yes|y|on) return 0 ;;
    *) return 1 ;;
  esac
}

normalise_path() {
  local value="$1"

  # On Windows GitHub runners bash usually runs under Git Bash, so convert native
  # drive paths into POSIX form when cygpath is available.
  if [[ "$value" =~ ^[A-Za-z]:[\\/] ]] && command -v cygpath >/dev/null 2>&1; then
    cygpath -u "$value"
    return
  fi

  printf '%s\n' "$value"
}

resolve_workdir() {
  local value
  value="$(normalise_path "$1")"

  # Resolve relative paths from the checked-out workspace so file arguments behave
  # the same way they would in a normal workflow step.
  if [[ "$value" = /* ]]; then
    printf '%s\n' "$value"
    return
  fi

  if [[ -n "${GITHUB_WORKSPACE:-}" ]]; then
    printf '%s\n' "$(normalise_path "$GITHUB_WORKSPACE")/$value"
    return
  fi

  printf '%s\n' "$(pwd)/$value"
}

latest_release_tag() {
  local tag=""

  if tag="$(gh release view --repo "$repo" --json tagName --jq .tagName 2>/dev/null)"; then
    if [[ -n "$tag" && "$tag" != "null" ]]; then
      printf '%s\n' "$tag"
      return
    fi
  fi

  printf '%s\n' ""
}

release_exists() {
  local tag="$1"

  gh release view "$tag" --repo "$repo" --json tagName --jq .tagName >/dev/null 2>&1
}

resolve_installation_source() {
  local ref="$1"
  local prefix=""
  local tag=""
  local latest_tag=""

  install_mode="release"
  resolved_ref=""

  if [[ -z "$ref" ]]; then
    log "No action version was set; resolving the latest ${package_name} release."
    tag="$(latest_release_tag)"
    if [[ -z "$tag" ]]; then
      warn_no_release
      return
    fi
    log "Resolved ${package_name} release: ${tag}"
    resolved_ref="$tag"
    return
  fi

  if [[ "$ref" =~ ^refs/tags/latest$ ]] || [[ "$ref" == "latest" ]]; then
    log "Action ref '${ref}' requests the latest released ${package_name} binary."
    tag="$(latest_release_tag)"
    if [[ -z "$tag" ]]; then
      warn_no_release
      return
    fi
    log "Resolved ${package_name} release: ${tag}"
    resolved_ref="$tag"
    return
  fi

  if [[ "$ref" =~ ^refs/tags/(.+)$ ]]; then
    ref="${BASH_REMATCH[1]}"
  elif [[ "$ref" =~ ^refs/heads/(.+)$ ]]; then
    ref="${BASH_REMATCH[1]}"
  fi

  # Fully pinned refs map straight to the exact release tag.
  if [[ "$ref" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    tag="v${ref#v}"
    if ! release_exists "$tag"; then
      latest_tag="$(latest_release_tag)"
      if [[ -z "$latest_tag" ]]; then
        warn_no_release
        return
      fi
      fail "Could not resolve the requested release '${tag}'."
    fi
    log "Resolved ${package_name} release: ${tag}"
    resolved_ref="$tag"
    return
  fi

  # Major-only or major.minor refs float to the latest matching release.
  if [[ "$ref" =~ ^v?([0-9]+)\.([0-9]+)$ ]]; then
    prefix="v${BASH_REMATCH[1]}.${BASH_REMATCH[2]}."
  elif [[ "$ref" =~ ^v?([0-9]+)$ ]]; then
    prefix="v${BASH_REMATCH[1]}."
  fi

  if [[ -n "$prefix" ]]; then
    tag="$(gh api "repos/${repo}/releases?per_page=100" --jq "[.[] | select((.draft | not) and (.prerelease | not) and (.tag_name | startswith(\"${prefix}\")))][0].tag_name")"
    if [[ -z "$tag" || "$tag" == "null" ]]; then
      latest_tag="$(latest_release_tag)"
      if [[ -z "$latest_tag" ]]; then
        warn_no_release
        return
      fi
      fail "Could not resolve a release matching action ref '${ref}'."
    fi
    log "Resolved ${package_name} release: ${tag}"
    resolved_ref="$tag"
    return
  fi

  # Branch names and commit SHAs use the source at that ref rather than a
  # released binary.
  install_mode="source"
  resolved_ref="$ref"
  log "Action ref '${ref}' will build ${package_name} from source."
}

build_from_source() {
  local source_dir="${SOURCE_CHECKOUT_DIR:-}"
  local output_path="${workdir}/${binary_name}${binary_ext}"

  if ! command -v go >/dev/null 2>&1; then
    fail "go is required to build ${package_name} from source."
  fi

  if [[ -z "$source_dir" || ! -d "$source_dir/cli" ]]; then
    fail "Checked-out source for ${package_name} was not found at '${source_dir}'."
  fi

  log "Building ${package_name} from checked-out source ref '${resolved_ref}'."
  go -C "$source_dir/cli" build -o "$output_path" .

  binary_path="$output_path"
  if [[ "$os" != "windows" ]]; then
    chmod +x "$binary_path"
  fi
  if [[ -n "${GITHUB_PATH:-}" ]]; then
    printf '%s\n' "$workdir" >> "$GITHUB_PATH"
  fi
}

detect_platform() {
  # Use runner metadata rather than uname so the action behaves predictably on
  # GitHub-hosted Linux, macOS and Windows runners.
  case "${RUNNER_OS:-}" in
    Linux)
      os="linux"
      archive_os="Linux"
      binary_ext=""
      ;;
    macOS)
      os="darwin"
      archive_os="Darwin"
      binary_ext=""
      ;;
    Windows)
      os="windows"
      archive_os="Windows"
      binary_ext=".exe"
      ;;
    *)
      fail "Unsupported runner OS '${RUNNER_OS:-unknown}'."
      ;;
  esac

  case "${RUNNER_ARCH:-}" in
    X64)
      arch="amd64"
      archive_arch="x86_64"
      ;;
    ARM64)
      arch="arm64"
      archive_arch="arm64"
      ;;
    *)
      fail "Unsupported runner architecture '${RUNNER_ARCH:-unknown}'."
      ;;
  esac
}

download_asset() {
  local tag="$1"
  local pattern="$2"

  # Release assets are named deterministically, so download by exact pattern.
  gh release download "$tag" --repo "$repo" --pattern "$pattern" --dir "$download_dir"
}

run_with_privilege() {
  # Native Linux installs may need elevation on hosted runners.
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
    return
  fi

  if [[ "$(id -u)" == "0" ]]; then
    "$@"
    return
  fi

  fail "Installing native Linux packages requires sudo or root."
}

install_native_linux() {
  local version="$1"
  local asset=""

  # On Linux, prefer native packages when the machine has a supported package
  # manager. Other platforms use the portable archive.
  if [[ "$os" != "linux" ]]; then
    return 1
  fi

  # Choose the package format that matches the current machine tooling.
  if command -v dpkg >/dev/null 2>&1; then
    asset="${binary_name}_${version}_linux_${arch}.deb"
    download_asset "$tag" "$asset"
    run_with_privilege dpkg -i "$download_dir/$asset"
  elif command -v rpm >/dev/null 2>&1; then
    asset="${binary_name}_${version}_linux_${arch}.rpm"
    download_asset "$tag" "$asset"
    run_with_privilege rpm -i "$download_dir/$asset"
  elif command -v apk >/dev/null 2>&1; then
    asset="${binary_name}_${version}_linux_${arch}.apk"
    download_asset "$tag" "$asset"
    run_with_privilege apk add --allow-untrusted "$download_dir/$asset"
  else
    return 1
  fi

  binary_path="$binary_name"
  return 0
}

install_archive() {
  local asset="${binary_name}_${archive_os}_${archive_arch}.tar.gz"

  # Archive installs are the portable fallback for macOS, Windows, and Linux
  # when we are not doing a package-manager installation.
  download_asset "$tag" "$asset"
  tar -xzf "$download_dir/$asset" -C "$workdir"

  binary_path="$workdir/${binary_name}${binary_ext}"
  if [[ "$os" != "windows" ]]; then
    chmod +x "$binary_path"
  fi

  if [[ -n "${GITHUB_PATH:-}" ]]; then
    printf '%s\n' "$workdir" >> "$GITHUB_PATH"
  fi
}

verify_installation() {
  local version_output=""

  version_output="$($binary_path --version)"
  if [[ "${install_mode:-}" == "source" ]]; then
    log "${package_name} is successfully built from source (${resolved_ref}), installed and ready to use. Version: ${version_output}"
    return
  fi

  log "${package_name} is successfully installed and ready to use. Version: ${version_output}"
}

run_cli() {
  # install-only stops after installation and deliberately ignores args.
  if is_true "$install_only"; then
    return
  fi

  # Run from the requested working directory so relative paths in args resolve
  # consistently with a normal workflow step.
  pushd "$workdir" >/dev/null
  if [[ -n "$args" ]]; then
    bash -lc "\"$binary_path\" $args"
  else
    "$binary_path"
  fi
  popd >/dev/null
}

if ! command -v gh >/dev/null 2>&1; then
  fail "gh CLI is required but was not found in PATH."
fi

# Prepare the destination before downloading anything.
workdir="$(resolve_workdir "$workdir_input")"
mkdir -p "$workdir"

detect_platform

# Resolve the installation source from the action ref.
install_mode=""
resolved_ref=""
resolve_installation_source "$action_ref"
if [[ -z "$resolved_ref" ]]; then
  exit 0
fi

binary_path=""
download_dir="$(mktemp -d)"

cleanup() {
  rm -rf "$download_dir"
}
trap cleanup EXIT

# Released versions prefer native Linux packages whenever they are available on
# the current machine. Other platforms, or Linux without a supported package
# manager, use the portable archive layout extracted into workdir. Branches and
# commit SHAs build the CLI directly from source.
if [[ "$install_mode" == "source" ]]; then
  build_from_source
else
  version="${resolved_ref#v}"
  tag="$resolved_ref"
  if install_native_linux "$version"; then
    :
  else
    install_archive
  fi
fi

verify_installation
run_cli
