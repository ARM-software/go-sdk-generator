# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

name: Lint GitHub Actions and local actions

on:
  workflow_dispatch:
  pull_request:
    branches:
      - main

permissions:
  contents: read

jobs:
  lint-workflows:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Resolve local action references for actionlint
        shell: bash
        run: |
          find .github/workflows actions -type f \( -name '*.yml' -o -name '*.yaml' \) \
            -exec sed -i 's|uses: \$/actions/|uses: ./actions/|g' {} +
      - name: Lint workflows
        uses: docker://rhysd/actionlint:1.7.12
      - name: Lint local actions
        shell: bash
        run: |
          set -euo pipefail
{{- range .GeneratedActions }}
          cat <<'EOF' | docker run --rm -i -v "$GITHUB_WORKSPACE:/repo:ro" -w /repo \
            rhysd/actionlint:1.7.12 -stdin-filename .github/workflows/lint-actions.yml -
          on: workflow_dispatch
          jobs:
            check:
              runs-on: ubuntu-latest
              steps:
                - uses: ./actions/{{ .DirectoryName }}
{{- $hasRequired := false }}
{{- range .Inputs }}
{{- if .Required }}
{{- $hasRequired = true }}
{{- end }}
{{- end }}
{{- if $hasRequired }}
                  with:
{{- range .Inputs }}
{{- if .Required }}
{{- if .IsBoolean }}
                    {{ .Name }}: true
{{- else if .IsOperand }}
                    {{ .Name }}: example-operand
{{- else }}
                    {{ .Name }}: example-value
{{- end }}
{{- end }}
{{- end }}
{{- end }}
          EOF
{{- end }}
