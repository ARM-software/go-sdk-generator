var {{ $nameLower }}Cmd = &cobra.Command{
	Use:   "{{ $nameLower }}",
	Short: "{{ .Description }}",
	Long:  "{{ .Description }}",
	Run: func(cmd *cobra.Command, args []string) {
		ctx := context.Background()
		logger, err := logs.NewStdLogger("{{ .Name }}")
		if err != nil {
			fmt.Printf("failed initialising the logger: %v\n", err.Error())
			os.Exit(1)
		}

		var {{ $nameLower }}Cfg config.{{ .Name }}Configuration

		{{ if $confFile }}
		confFile := "{{ $confFile }}"
		if filesystem.Exists(confFile) {
			err = configUtils.LoadFromEnvironment(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ .Name }}Configuration(), confFile)
		} else {
			err = configUtils.LoadFromViper(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ .Name }}Configuration())
		} 
		{{ else -}}
		err = configUtils.LoadFromViper(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ .Name }}Configuration())
		{{ end -}}
		if err != nil {
			logger.LogError(err, "failed initialising {{ $nameLower }} command")
			os.Exit(1)
		}

		cancellableCtx, cancel := addInterruptHandlerToContext(ctx)
		defer cancel()

		err = {{ $package }}.Wrap{{ .Name }}(cancellableCtx, logger, &{{ $nameLower }}Cfg, {{ $package }}.{{ .Name }}ImplFunc)
		if err != nil {
			logger.LogError(err)
			cancel()
			os.Exit(1)
		}
	},
}
