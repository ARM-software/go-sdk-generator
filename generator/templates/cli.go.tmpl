		{{ if $confFile }}
		confFile := "{{ $confFile }}"
		if filesystem.Exists(confFile) {
			err = configUtils.LoadFromEnvironment(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration(), confFile)
		} else {
			err = configUtils.LoadFromViper(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration())
		} 
		{{ else -}}
		err = configUtils.LoadFromViper(viperSession, app, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration())
		{{ end -}}
		if err != nil {
			logger.LogError(err, "failed initialising {{ $nameLower }} command")
			os.Exit(1)
		}
		{{ if .Operands }}
		{{ $nameLower }}Cfg.Operands = args
		{{ end }}
		cancellableCtx, cancel := addInterruptHandlerToContext(ctx)
		defer cancel()

        cliVersion, err := semver.DetermineEmbeddedVersion(cancellableCtx, &embeddedFS, nil)
        if err == nil {
            {{ $nameLower }}Cfg.ToolVersion = field.ToOptionalString(cliVersion)
        }

		err = {{ $package }}.Wrap{{ .Name | toPascal }}(cancellableCtx, logger, &{{ $nameLower }}Cfg, {{ $package }}.{{ .Name }}ImplFunc)
		if err != nil {
			logger.LogError(err)
			cancel()
			os.Exit(1)
		}
	},
}
