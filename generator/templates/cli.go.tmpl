func addInterruptHandlerToContext(ctx context.Context) (cancellableCtx context.Context, cancel context.CancelFunc) {
	cancellableCtx, cancel = context.WithCancel(ctx)
	end := make(chan error, 1)
	go func() {
		// Waits for a user interrupt or SIGTERM or expired/cancelled context
		shutdown := make(chan os.Signal, 1)
		signal.Notify(shutdown, syscall.SIGINT, syscall.SIGTERM, os.Interrupt)
		for wait := true; wait; {
			select {
			case <-shutdown:
				wait = false
			case <-ctx.Done():
				wait = false
			}
		}

		cancel()
		close(end)
	}()
	return
}

{{ range .Specification.CommandLineCommands.Functions }}
{{ $nameLower := .Name | lower }}
var {{ $nameLower }}Cfg config.{{ .Name }}Configuration

var {{ $nameLower }}Func func(context.Context, logs.Loggers, *config.{{ .Name }}Configuration) error = nil

var {{ $nameLower }}Cmd = &cobra.Command{
	Use:   "{{ $nameLower }}",
	Short: "{{ .Description }}",
	Long:  "{{ .Description }}",
	Run: func(cmd *cobra.Command, args []string) {
		ctx := context.Background()
		logger, err := logs.NewStdLogger("{{ .Name }}")
		if err != nil {
			fmt.Printf("failed initialising the logger: %v\n", err.Error())
			os.Exit(1)
		}

		err = configUtils.LoadFromViper(viperSession, app, &{{ $nameLower }}Cfg, config.NewDefault{{ .Name }}Configuration())
		if err != nil {
			logger.LogError(err, "failed initialising {{ $nameLower }} command")
			os.Exit(1)
		}

		cancellableCtx, cancel := addInterruptHandlerToContext(ctx)
		defer cancel()

		err = {{ $package }}.{{ .Name }}(cancellableCtx, logger, &{{ $nameLower }}Cfg, {{ $nameLower }}Func)
		if err != nil {
			logger.LogError(err)
			cancel()
			os.Exit(1)
		}
	},
}
{{ end }}

