	{{ range .Specification.CommandLineCommands.Functions -}}
	{{ $functionName := .Name -}}
	{{ range .Configuration -}}
	{{ if not .is_root -}}
	{{ $mapstructure:= .mapstructure_tag -}}
	{{ if .bindings -}}
	{{ range .bindings -}}
	{{ $functionName | lower }}{{ .name }}Arg = "{{ $mapstructure | replaceUnderscores }}-{{ .mapstructure_tag | replaceUnderscores }}"
	{{ end -}}
	{{ else -}}
