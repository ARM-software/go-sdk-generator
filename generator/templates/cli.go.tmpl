// Package cmd defines all the CLI commands for {{ .Specification.Name }}
package cmd

import (
	"context"

	"github.com/ARM-software/golang-utils/utils/commonerrors"
	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/ARM-software/golang-utils/utils/field"
	"github.com/ARM-software/golang-utils/utils/logs"
	"github.com/ARM-software/golang-utils/utils/semver"
	"github.com/spf13/cobra"

	"github.com/Arm-Debug/{{ .Specification.PackageName }}/cli/cmd/config"
	"github.com/Arm-Debug/{{ .Specification.PackageName }}/cli/cmd/{{ $moduleDir }}"
)

const (
	{{- range .CliArgConsts }}
	{{ .Name }} = "{{ .Value }}"{{ if .NoLint }} //nolint:gosec // not a secret {{ end }}
	{{- end }}
)

func addInterruptHandlerToContext(ctx context.Context) (cancellableCtx context.Context, cancel context.CancelCauseFunc) {
	var cause error
	cancellableCtx, cancel = context.WithCancelCause(ctx)
	end := make(chan error, 1)
	go func() {
		// Waits for a user interrupt or SIGTERM or expired/cancelled context
		shutdown := make(chan os.Signal, 1)
		signal.Notify(shutdown, syscall.SIGINT, syscall.SIGTERM, os.Interrupt)
		for wait := true; wait; {
			select {
			case s := <-shutdown:
				cause = commonerrors.Newf(commonerrors.ErrInterrupted, "received signal '%v'", s)
				wait = false
			case <-ctx.Done():
				wait = false
			}
		}

		cancel(cause)
		close(end)
	}()
	return
}

{{ range .Specification.CommandLineCommands.Functions }}
{{ $nameLower := .Name | lower }}
{{ $configName:= .Name | toPascal -}}
{{ $loadFromEnvFunc := "LoadFromEnvironment" -}}
{{ $loadFromViperFunc := "LoadFromViper" -}}
{{ if .LoadFromKeyring }}
    {{ $loadFromEnvFunc = "LoadFromEnvironment" -}}
    {{ $loadFromViperFunc = "LoadFromViperAndSystem" -}}
{{ end }}

var {{ $nameLower }}Cmd = &cobra.Command{
	Use:   "{{ $nameLower }}",
	Short: "{{ .Description }}",
	Long:  "{{ .Description }}",
	RunE: func(cmd *cobra.Command, args []string) (err error) {
		ctx := context.Background()
		logger, err := logs.NewStdLogger("{{ .Name | toPascal }}")
		if err != nil {
			err = commonerrors.WrapError(commonerrors.ErrUnexpected, err, "failed initialising the logger")
			return
		}

		var {{ $nameLower }}Cfg config.{{ $configName }}Configuration

		{{ if $confFile }}
		confFile := "{{ $confFile }}"
		if filesystem.Exists(confFile) {
			err = configUtils.{{ $loadFromEnvFunc }}(viperSession, config.App, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration(), confFile)
		} else {
			err = configUtils.{{ $loadFromViperFunc }}(viperSession, config.App, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration())
		} 
		{{ else -}}
		err = configUtils.{{ $loadFromViperFunc }}(viperSession, config.App, &{{ $nameLower }}Cfg, config.Default{{ $configName }}Configuration())
		{{ end -}}
		if err != nil {
			return
		}
		{{ if .Operands }}
		{{ $nameLower }}Cfg.Operands = args
		{{ end }}
		cancellableCtx, cancel := addInterruptHandlerToContext(ctx)
		defer cancel(nil)

		cliVersion, err := semver.DetermineEmbeddedVersion(cancellableCtx, &embeddedFS, nil)
        if err == nil {
            {{ $nameLower }}Cfg.ToolVersion = field.ToOptionalString(cliVersion)
        }

		err = {{ $package }}.Wrap{{ .Name | toPascal }}(cancellableCtx, logger, &{{ $nameLower }}Cfg, {{ $package }}.{{ .Name }}ImplFunc)
		if err != nil {
			cancel(nil)
			return
		}

		return
	},
    {{ if .SilenceUsage -}}
    SilenceUsage: true, // otherwise 'Usage' is printed after any error
    {{ end -}}
    {{ if .Hidden -}}
    Hidden: true,
    {{ end -}}
}
{{ end }}

func init() {
    {{- range .FlagRegistrations }}
    {{ .FlagLine }}
    {{- end }}

	{{ range .CliEnvVarBindings }}
	{{- if gt (len .FlagBindings) 1 }}
	_ = configUtils.BindFlagsToEnv(viperSession, config.App, "{{ .EnvVar }}", {{- range $i, $flag := .FlagBindings -}}{{ if $i }}, {{ end }}{{ $flag }}{{- end -}})
	{{- else }}
	_ = configUtils.BindFlagToEnv(viperSession, config.App, "{{ .EnvVar }}", {{ index .FlagBindings 0 }})
	{{- end }}
	{{- end }}

	{{ range .Specification.CommandLineCommands.Functions }}
	rootCmd.AddCommand({{ .Name | lower }}Cmd)
	{{- end }}
}
