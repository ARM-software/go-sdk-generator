var versionCmd = &cobra.Command{
	Use:   "version",
	Short: "Prints tool's version",
	Long:  "Prints tool's version in standard output (StdOut). The version follows SemVer.",
	Run: func(cmd *cobra.Command, args []string) {
		ctx := context.Background()
		logger, err := logs.NewStdLogger("Version")
		if err != nil {
			fmt.Printf("failed initialising the logger: %v\n", err.Error())
			os.Exit(1)
		}
		cancellableCtx, cancel := addInterruptHandlerToContext(ctx)
		defer cancel()

		version, err := semver.DetermineEmbeddedVersion(cancellableCtx, &embeddedFS, nil)
		if err != nil {
			logger.LogError(err)
			cancel()
			os.Exit(1)
		}
		fmt.Println(version)
	},
}

