# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

{{- $cliPackage := "cli" -}}
{{- if .Specification.CommandLineCommands }}
{{- $cliPackage = .Specification.CommandLineCommands.Package -}}
{{- end }}

name: CI

on:
  push:
    branches: [main]
    tags-ignore:
      - "**"
  pull_request:
    branches:
      - main

env:
  go_version: "{{ .TargetedGoVersion }}"

x-setup-go-step: &x-setup-go-step
  name: Set up Go
  uses: actions/setup-go@v6
  with:
    go-version: ${{ "{{" }} env.go_version }}

x-go-mod-tidy-step: &x-go-mod-tidy-step
  name: Tidy dependencies
  run: go mod tidy

x-go-generate-step: &x-go-generate-step
  name: Generate code
  run: go generate -x ./...

x-go-work-sync-step: &x-go-work-sync-step
  name: Sync go.work
  run: go work sync

jobs:
  assert-news:
    name: Assert news files (See CONTRIBUTING.md)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v6
      - name: Install CI/CD tools
        run: pip install continuous-delivery-scripts && pip list
      - name: Assert news
        run: cd-assert-news -b ${{ "{{" }} github.head_ref || github.ref_name }}
        env:
          GIT_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN || github.token }}
      - name: Report failure if needed
        if: ${{ "{{" }} failure() }}
        run: |
          echo "::error:: News file missing (See CONTRIBUTING.md guide for details)."
          echo "## :warning: CI failure" >> "$GITHUB_STEP_SUMMARY"
          echo "News file missing. See \\`CONTRIBUTING.md\\` for the expected news file format and location." >> "$GITHUB_STEP_SUMMARY"

  detect-secrets:
    name: Check for secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v6
      - name: Install CI/CD tools
        run: pip install continuous-delivery-scripts && pip list
      - name: Detect secrets
        run: cd-detect-secrets
      - name: Report failure if needed
        if: ${{ "{{" }} failure() }}
        run: |
          echo "::error:: Potential secrets detected in the repository."
          echo "## :rotating_light: CI failure" >> "$GITHUB_STEP_SUMMARY"
          echo "Potential secrets were detected in the repository." >> "$GITHUB_STEP_SUMMARY"

  update-generated-files:
    name: Update generated files
    runs-on: ubuntu-latest
    if: ${{ "{{" }} github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository }}
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ "{{" }} github.event.pull_request.head.ref }}
          token: ${{ "{{" }} secrets.GITHUB_TOKEN || github.token }}
      - *x-setup-go-step
      - <<: *x-go-mod-tidy-step
        name: Go mod tidy ({{ .Specification.MainModule }})
        working-directory: {{ .Specification.MainModule }}
      - <<: *x-go-generate-step
        name: Run go generate ({{ .Specification.MainModule }})
        working-directory: {{ .Specification.MainModule }}
      - <<: *x-go-mod-tidy-step
        name: Go mod tidy after generation ({{ .Specification.MainModule }})
        working-directory: {{ .Specification.MainModule }}
{{- if .Specification.CommandLineCommands }}
      - <<: *x-go-mod-tidy-step
        name: Go mod tidy ({{ .Specification.CommandLineCommands.Package }})
        working-directory: {{ .Specification.CommandLineCommands.Package }}
      - <<: *x-go-generate-step
        name: Run go generate ({{ .Specification.CommandLineCommands.Package }})
        working-directory: {{ .Specification.CommandLineCommands.Package }}
      - <<: *x-go-mod-tidy-step
        name: Go mod tidy after generation ({{ .Specification.CommandLineCommands.Package }})
        working-directory: {{ .Specification.CommandLineCommands.Package }}
{{- end }}
      - *x-go-work-sync-step
      - name: Commit generated changes
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore: regenerate generated files"
      - name: Report failure if needed
        if: ${{ "{{" }} failure() }}
        run: |
          echo "## :warning: CI failure" >> "$GITHUB_STEP_SUMMARY"
          echo "Generated files could not be refreshed and committed automatically." >> "$GITHUB_STEP_SUMMARY"

  build-and-test:
    strategy:
      matrix:
        os: [ubuntu-latest, macOS-latest, windows-latest]
        go-module: [{{ .Specification.MainModule }}{{ if .Specification.CommandLineCommands }}, {{ $cliPackage }}{{ end }}]
    name: Build and test
    runs-on: ${{ "{{" }} matrix.os }}
    steps:
      - uses: actions/checkout@v6
      - *x-setup-go-step
      - <<: *x-go-mod-tidy-step
        if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') }}
        working-directory: ${{ "{{" }} matrix.go-module }}
      - <<: *x-go-generate-step
        if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') }}
        working-directory: ${{ "{{" }} matrix.go-module }}
      - <<: *x-go-mod-tidy-step
        if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') }}
        name: Go mod tidy (after generation)
        working-directory: ${{ "{{" }} matrix.go-module }}
      - <<: *x-go-work-sync-step
        if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') && matrix.go-module == '{{ $cliPackage }}' }}
      - if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') }}
        name: Linting
        uses: golangci/golangci-lint-action@v9
        with:
          version: latest
          working-directory: ${{ "{{" }} matrix.go-module }}
          args: "--verbose --output.text.print-issued-lines --output.text.print-linter-name --output.tab.colors --max-issues-per-linter 0 --max-same-issues 0"
      - name: Build ${{ "{{" }} matrix.go-module }} on ${{ "{{" }} matrix.os }}
        run: go build -v ./...
        working-directory: ${{ "{{" }} matrix.go-module }}
      - if: ${{ "{{" }} startsWith(matrix.os, 'ubuntu') && matrix.go-module != '{{ $cliPackage }}' }}
        name: Test ${{ "{{" }} matrix.go-module }} on ${{ "{{" }} matrix.os }}
        run: go test -race -cover -v -tags integration -timeout 30m ./...
        working-directory: ${{ "{{" }} matrix.go-module }}
      - name: Report failure if needed
        if: ${{ "{{" }} failure() }}
        run: |
          echo "## :warning: CI failure" >> "$GITHUB_STEP_SUMMARY"
          echo "Build, linting, or tests failed for module \\`${{ "{{" }} matrix.go-module }}\\` on runner \\`${{ "{{" }} matrix.os }}\\`." >> "$GITHUB_STEP_SUMMARY"

{{- if .InstallAction }}
  dogfood-action:
    name: Dogfood Action
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v6
      - name: Set up Go
        uses: actions/setup-go@v6
        with:
          go-version: ${{ "{{" }} env.go_version }}
      - name: Detect whether published releases exist
        id: published-releases
        env:
          GH_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN || github.token }}
        run: |
          has_release="$(gh api "repos/${{ "{{" }} github.repository }}/releases?per_page=1" --jq 'length > 0')"
          echo "has-release=${has_release}" >> "$GITHUB_OUTPUT"
      - name: Run local action against published release
        if: steps.published-releases.outputs.has-release == 'true'
        id: install-published-release
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}
      - name: Verify published release cmd output
        if: steps.published-releases.outputs.has-release == 'true'
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-published-release.outputs.cmd }}"
          test -n "$cmd"
      - name: Skip published release install check when no releases exist
        if: steps.published-releases.outputs.has-release != 'true'
        run: echo "No published GitHub release exists yet; skipping published release install check."
      - name: Run local action at current commit SHA
        id: install-current-sha
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}
          action-ref: ${{ "{{" }} github.sha }}
      - name: Verify current commit SHA cmd output
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-current-sha.outputs.cmd }}"
          test -n "$cmd"
      - name: Run local action and force source build
        id: install-force-source
        env:
          FORCE_SOURCE_BUILD: "true"
        uses: ./actions/{{ .InstallAction.DirectoryName }}
        with:
          action-repo: ${{ "{{" }} github.repository }}
      - name: Verify forced source build cmd output
        shell: bash
        run: |
          cmd="${{ "{{" }} steps.install-force-source.outputs.cmd }}"
          test -n "$cmd"
      - name: Report failure if needed
        if: ${{ "{{" }} failure() }}
        run: |
          echo "## :warning: CI failure" >> "$GITHUB_STEP_SUMMARY"
          echo "Dogfooding the generated GitHub Action failed." >> "$GITHUB_STEP_SUMMARY"
{{- end }}
