# Code generated by our bespoke codegen `go-sdk-generator` ({{ .ToolVersion }}).

version: 2
project_name: {{ .Specification.PackageName }}
# Whether to enable the size reporting or not.
report_sizes: true
env:
  - GO111MODULE=on
builds:
  - dir: {{ .Specification.CommandLineCommands.Package }}
    id: {{ .Specification.PackageName }}
    binary: {{ .Specification.CommandLineCommands.Binary }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
      - windows
      - darwin
    # Build for 64 bit Arm and Intel/AMD processors
    goarch:
      - amd64
      - arm64
    hooks:
      pre:
        - chmod +x scripts/pre.sh
        - scripts/pre.sh
archives:
  - name_template: >-
      {{ "{{" }} .ProjectName }}_
      {{ "{{" }}- title .Os }}_
      {{ "{{" }}- if eq .Arch "amd64" }}x86_64
      {{ "{{" }}- else if eq .Arch "386" }}i386
      {{ "{{" }}- else }}{{ "{{" }} .Arch }}{{ "{{" }} end }}
    files:
      - LICENSE
sboms:
  - artifacts: binary
checksum:
  name_template: "checksums.txt"
snapshot:
  version_template: "{{ "{{" }} incpatch .Tag }}-dev"
changelog:
  sort: asc
  filters:
    exclude:
      - "^docs:"
      - "^changes:"
      - "^test:"
nfpms:
  - formats:
      - deb
      - rpm
    id: linux-packages
    license: {{ .Specification.Licence }}
    maintainer: Arm Online Services <monty-bot@arm.com>
    description: |-
      {{ .Specification.Description }}
    contents:
      - src: ./LICENSE
        dst: {{ .Distribution.ToolLicencePath }}
      - src: ./.manpages/
        dst: /usr/share/man/man1/
        type: tree
      - src: ./.agents/skills/
        dst: {{ .Distribution.ToolSkillsPath }}/
        type: tree
  - formats:
      - apk
    id: alpine-package
    license: {{ .Specification.Licence }}
    maintainer: Arm Online Services <monty-bot@arm.com>
    description: |-
      {{ .Specification.Description }}
    contents:
      # FIXME: nfpm currently produces APK archives that apk-tools rejects when a
      # contents entry uses `type: tree`, so APK packaging lists the skill files
      # explicitly instead of packaging the whole directory as a tree.
      - src: ./LICENSE
        dst: {{ .Distribution.ToolLicencePath }}
      - src: ./.manpages/
        dst: /usr/share/man/man1/
        type: tree
      - src: ./.agents/skills/{{ installSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
        dst: {{ .Distribution.ToolSkillsPath }}/{{ installSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
      - src: ./.agents/skills/{{ runSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
        dst: {{ .Distribution.ToolSkillsPath }}/{{ runSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
{{- if .GeneratedActions }}
      - src: ./.agents/skills/{{ githubActionSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
        dst: {{ .Distribution.ToolSkillsPath }}/{{ githubActionSkillName .Specification.CommandLineCommands.Binary }}/SKILL.md
{{- end }}
{{ if .OCI.PublishesToGHCR }}
dockers_v2:
  - id: {{ .Specification.PackageName }}-ubuntu
    dockerfile: Dockerfile.oci.ubuntu
    images:
      - {{ .OCI.ImageName }}
    tags:
      - v{{ "{{" }} .Version }}-ubuntu
    platforms:
      - linux/amd64
      - linux/arm64
    labels:
{{- range .OCI.Labels }}
      {{ .Name | quote }}: {{ .Value | quote }}
{{- end }}
    annotations:
{{- range .OCI.Attributes }}
      {{ .Name | quote }}: {{ .Value | quote }}
{{- end }}
  # FIXME: Alpine OCI image publishing is temporarily disabled because the
  # nfpm-generated APK currently fails to install with `package file format
  # error` during image assembly. Upstream tracking issue:
  # https://github.com/goreleaser/nfpm/issues/1117
  # - id: {{ .Specification.PackageName }}-alpine
  #   dockerfile: Dockerfile.oci.alpine
  #   images:
  #     - {{ .OCI.ImageName }}
  #   tags:
  #     - v{{ "{{" }} .Version }}-alpine
  #   platforms:
  #     - linux/amd64
  #     - linux/arm64
  #   labels:
{{- range .OCI.Labels }}
  #     {{ .Name | quote }}: {{ .Value | quote }}
{{- end }}
  #   annotations:
{{- range .OCI.Attributes }}
  #     {{ .Name | quote }}: {{ .Value | quote }}
{{- end }}
{{ end }}
release:
  discussion_category_name: Releases
  # If the version tag looks like a pre-release e.g. beta then the GitHub release is set to prerelease
  prerelease: auto
  name_template: "Release {{ "{{" }}.Version}}"
