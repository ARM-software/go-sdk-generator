# Code generated by go-sdk-generator ({{ .ToolVersion }}).
name: Validate Agent Skills
description: Validate skill metadata and resources, then test isolated local installation using pinned tools.
inputs:
  path:
    description: Repository or local skill collection to check
    default: '.'
  install:
    description: Also run isolated Skills CLI discovery and installation checks
    default: 'true'
runs:
  using: composite
  steps:
    - uses: actions/setup-go@d35c59abb061a4a6fb18e82ac0862c26744d6ab5 # v5.5.0
      with:
        go-version: '{{ .TargetedGoVersion }}'
        cache: false
    - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
      with:
        python-version: '3.11'
    - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
      with:
        node-version: '22.20.0'
    - name: Install pinned validation tools
      shell: bash
      run: |
        go install github.com/coolapso/agent-skills-validator@v0.2.0
        python -m pip install -r "$GITHUB_ACTION_PATH/requirements.txt"
    - name: Check skills
      shell: bash
      env:
        SKILLS_ROOT: ${{ "{{" }} inputs.path }}
        CHECK_INSTALL: ${{ "{{" }} inputs.install }}
      run: |
        args=()
        if [[ "$CHECK_INSTALL" == 'true' ]]; then
          args+=(--install)
        elif [[ "$CHECK_INSTALL" != 'false' ]]; then
          echo 'install must be true or false' >&2
          exit 2
        fi
        python "$GITHUB_ACTION_PATH/validate_skills.py" "$SKILLS_ROOT" "${args[@]}"
