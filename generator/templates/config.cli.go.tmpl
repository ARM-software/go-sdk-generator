package config

import (
	"regexp"

	"github.com/ARM-software/golang-utils/utils/logs"
	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/go-ozzo/ozzo-validation/v4/is"
	validation "github.com/go-ozzo/ozzo-validation/v4"

	{{ if .Specification.AdditionalTypes -}}
	"github.com/Arm-Debug/{{ .Specification.PackageName }}/{{ .Specification.MainModule }}/types"	
	{{ end -}}
	{{ range .Specification.ExtraImports -}}
	{{ .ImportRef }} "{{ .ImportUrl }}"
	{{ end -}}
)


{{ range .Specification.CommandLineCommands.Functions -}}
// {{ .Name }}Configuration defines the configuration for {{ .Name }} command
type {{ .Name }}Configuration struct {
	{{ range .Configuration -}}
		// {{ .description }}
		{{ .name }} {{ .lang_type | convertLangType }} `mapstructure:"{{ .mapstructure_tag }}"`
	{{ end }}
	    // ToolVersion contains the version of the CLI tool
		ToolVersion *string
}

func (cfg *{{ .Name }}Configuration) Validate() error {
	err := configUtils.ValidateEmbedded(cfg)
	if err != nil {
		return err
	}
	
	return validation.ValidateStruct(cfg,
	{{ range .Configuration -}}
	{{ if not .bindings -}}
	{{ $validation := .lang_type | validationLangType -}}
	{{ if .required -}}
		validation.Field(&cfg.{{ .name }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }}),
	{{ else if .condition -}}
		validation.Field(&cfg.{{ .name }}, validation.When(cfg.{{ .condition }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }})),
	{{ else if $validation -}}
		validation.Field(&cfg.{{ .name }}{{ $validation }}),
	{{ end -}}
	{{ end -}}
	{{ end -}}
	)
}

func Default{{ .Name }}Configuration() *{{ .Name }}Configuration {
	return &{{ .Name }}Configuration{
	{{ range .Configuration -}}
	{{ if not .bindings }}
	{{ if .default_value -}}
	{{ .name }}: {{ defaultValue .lang_type .default_value }},
	{{ end -}}
	{{ else }}
	{{ .name }}: {{ defaultValue .lang_type .default_value }},
	{{ end -}}
	{{ end -}}
	}
}
{{ end }}
