package config

import (
	"regexp"

	"github.com/ARM-software/golang-utils/utils/logs"
	configUtils "github.com/ARM-software/golang-utils/utils/config"
	"github.com/go-ozzo/ozzo-validation/v4/is"
	validation "github.com/go-ozzo/ozzo-validation/v4"

	{{ if .Specification.AdditionalTypes -}}
	"github.com/Arm-Debug/{{ .Specification.PackageName }}/{{ .Specification.MainModule }}/types"	
	{{ end -}}
	{{ range .Specification.ExtraImports -}}
	{{ .ImportRef }} "{{ .ImportUrl }}"
	{{ end -}}
)


{{ range .Specification.CommandLineCommands.Functions -}}
{{ $configName:= .Name | toPascal -}}
// {{ $configName }}Configuration defines the configuration for {{ $configName }} command
type {{ $configName }}Configuration struct {
	{{ range .Configuration -}}
		// {{ .description }}
		{{ .name | toPascal }} {{ .lang_type | convertLangType }} `mapstructure:"{{ .mapstructure_tag | toSnake }}"`
	{{ end }}
	    // ToolVersion contains the version of the CLI tool
		ToolVersion *string
	{{ if .AllowPositionalArgs -}}
		// ExtraArgs contains any extra arguments that were passed through the cobra flags
		ExtraArgs []string
	{{ end }}
}

func (cfg *{{ $configName }}Configuration) Validate() error {
	err := configUtils.ValidateEmbedded(cfg)
	if err != nil {
		return err
	}
	
	return validation.ValidateStruct(cfg,
	{{ range .Configuration -}}
	{{ if not .bindings -}}
	{{ $validation := .lang_type | validationLangType -}}
	{{ if eq .lang_type "bool" -}}
	{{ if .condition -}}
	    validation.Field(&cfg.{{ .name | toPascal }}, validation.When(cfg.{{ .condition }}{{ $validation }})),
	{{ else -}}
        validation.Field(&cfg.{{ .name | toPascal }}{{ $validation }}),
	{{ end -}}
	{{ else -}}
	{{ if .required -}}
		validation.Field(&cfg.{{ .name | toPascal }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }}),
	{{ else if .condition -}}
		validation.Field(&cfg.{{ .name | toPascal }}, validation.When(cfg.{{ .condition }}, validation.Required{{ $validation }}{{ if .pattern }}, validation.Match(regexp.MustCompile(`{{ .pattern }}`)){{ end }})),
	{{ else if $validation -}}
		validation.Field(&cfg.{{ .name | toPascal }}{{ $validation }}),
	{{ end -}}
	{{ end -}}
	{{ end -}}
	{{ end -}}
	)
}

func Default{{ $configName }}Configuration() *{{ $configName }}Configuration {
	return &{{ $configName }}Configuration{
	{{ range .Configuration -}}
	{{ if not .bindings }}
	{{ if .default_value -}}
	{{ .name  | toPascal }}: {{ defaultValue .lang_type .default_value }},
	{{ end -}}
	{{ else }}
	{{ .name  | toPascal }}: {{ defaultValue .lang_type .default_value }},
	{{ end -}}
	{{ end -}}
	}
}
{{ end }}
