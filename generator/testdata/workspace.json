{
  "specification": {
    "package_name": "workspace-service-sdk",
    "main_module": "workspace",
    "name": "Workspace",
    "description": "Create and manipulate workspaces",
    "additional_types": [
      {
        "name": "Project",
        "description": "A project",
        "fields": [
          {
            "name": "Path",
            "lang_type": "string",
            "json_tag": "path",
            "mapstructure_tag": "path",
            "required": true,
            "description": "Path to a project file"
          },
          {
            "name": "Name",
            "lang_type": "string",
            "json_tag": "name",
            "mapstructure_tag": "name",
            "description": "Name of the project"
          },
          {
            "name": "Title",
            "lang_type": "string",
            "json_tag": "title",
            "mapstructure_tag": "title",
            "description": "Human readable title for the project"
          },
          {
            "name": "Version",
            "lang_type": "version",
            "json_tag": "version",
            "mapstructure_tag": "version",
            "description": "The version of the project"
          },
          {
            "name": "Description",
            "lang_type": "string",
            "json_tag": "description",
            "mapstructure_tag": "description",
            "description": "The description of the project"
          },
          {
            "name": "DocumentationURL",
            "lang_type": "url",
            "json_tag": "documentation_url",
            "mapstructure_tag": "documentation_url",
            "description": "The URL to the documentation for the example"
          },
          {
            "name": "Format",
            "lang_type": "string",
            "json_tag": "format",
            "mapstructure_tag": "format",
            "description": "Format of the project (e.g. uvprojx/csolution)"
          },
          {
            "name": "Source",
            "lang_type": "project.Origin",
            "json_tag": "source",
            "mapstructure_tag": "source",
            "description": "Source (URL and type) of the project"
          },
          {
            "name": "Archive",
            "lang_type": "project.Archive",
            "json_tag": "archive",
            "mapstructure_tag": "archive",
            "description": "Archive information for the project"
          },
          {
            "name": "Convertible",
            "lang_type": "bool",
            "json_tag": "convertible",
            "mapstructure_tag": "convertible",
            "description": "Is the project convertible to csolution"
          },
          {
            "name": "Requirements",
            "lang_type": "project.Requirements",
            "json_tag": "requirements",
            "mapstructure_tag": "requirements",
            "description": "Requirements (e.g. toolchains) needed for the project"
          },
          {
            "name": "Keywords",
            "lang_type": "[]string",
            "json_tag": "keywords",
            "mapstructure_tag": "keywords",
            "description": "Keywords for this project"
          },
          {
            "name": "Categories",
            "lang_type": "[]string",
            "json_tag": "categories",
            "mapstructure_tag": "categories",
            "description": "Categories for this project"
          },
          {
            "name": "BoardID",
            "lang_type": "uuid",
            "json_tag": "board_id",
            "mapstructure_tag": "board_id",
            "description": "Unique board ID that this project refers to"
          },
          {
            "name": "RelatedPack",
            "lang_type": "string",
            "json_tag": "related_pack",
            "mapstructure_tag": "related_pack",
            "description": "Pack that contains this project"
          }
        ]
      }
    ],
    "interface": {
      "methods": [
        {
          "name": "SetWorkspaceName",
          "description": "Set the workspace name",
          "args": [
            {
              "name": "name",
              "lang_type": "string",
              "description": "The workspace name"
            }
          ],
          "returns": [
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the fetch failed"
            }
          ]
        },
        {
          "name": "GetWorkspaceName",
          "description": "Get the workspace name",
          "returns": [
            {
              "name": "name",
              "lang_type": "string",
              "reference": true,
              "description": "The workspace name"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the fetch failed"
            }
          ]
        },
        {
          "name": "CreateWorkspace",
          "description": "Create a workspace",
          "args": [
            {
              "name": "name",
              "lang_type": "string",
              "description": "The workspace name"
            },
            {
              "name": "sourceName",
              "lang_type": "string",
              "description": "The workspace source type (git/zip)"
            }
          ],
          "returns": [
            {
              "name": "item",
              "lang_type": "client.WorkspaceItem",
              "reference": true,
              "description": "The workspace item"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the creation failed"
            }
          ]
        },
        {
          "name": "RetainWorkspace",
          "description": "Retain a workspace",
          "args": [
            {
              "name": "name",
              "lang_type": "string",
              "description": "The workspace name"
            }
          ],
          "returns": [
            {
              "name": "item",
              "lang_type": "client.WorkspaceItem",
              "reference": true,
              "description": "The workspace item"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the retain failed"
            }
          ]
        },
        {
          "name": "ListWorkspaces",
          "description": "List workspaces",
          "returns": [
            {
              "name": "collection",
              "lang_type": "client.WorkspaceCollection",
              "reference": true,
              "description": "The collection of workspaces"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the list failed"
            }
          ]
        },
        {
          "name": "GetWorkspaceZipSourceEtag",
          "description": "Get the ETAG for a workspace source of type zip",
          "args": [
            {
              "name": "name",
              "lang_type": "string",
              "description": "The workspace name"
            }
          ],
          "returns": [
            {
              "name": "etag",
              "lang_type": "string",
              "description": "The etag for the zip source"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the etag fetch failed"
            }
          ]
        },
        {
          "name": "UploadWorkspaceContent",
          "description": "Upload content to a workspace",
          "args": [
            {
              "name": "artefact",
              "lang_type": "string",
              "description": "The artefact to upload"
            }
          ],
          "returns": [
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the upload failed"
            }
          ]
        },
        {
          "name": "FetchRepository",
          "description": "Fetch content from a git repository",
          "args": [
            {
              "name": "url",
              "lang_type": "string",
              "description": "Repository URL"
            },
            {
              "name": "ref",
              "lang_type": "string",
              "description": "Repository reference"
            }
          ],
          "returns": [
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the fetch failed"
            }
          ]
        },
        {
          "name": "ZipWorkspace",
          "description": "Zip a directory for a worspace",
          "args": [
            {
              "name": "uuid",
              "lang_type": "string",
              "description": "Unique identifier for the zip"
            },
            {
              "name": "inputPath",
              "lang_type": "string",
              "description": "Path to the zip"
            },
            {
              "name": "ignoreRegex",
              "lang_type": "[]string",
              "description": "List of regexes to ignore during zip"
            }
          ],
          "returns": [
            {
              "name": "zipOutput",
              "lang_type": "string",
              "description": "Path to the zipped output"
            },
            {
              "name": "err",
              "lang_type": "error",
              "description": "Whether the zip failed"
            }
          ]
        }
      ]
    },
    "global_configuration": [
      {
        "name": "BearerToken",
        "lang_type": "string",
        "required": true,
        "mapstructure_tag": "bearer_token",
        "pattern": "[a-z]+",
        "description": "An authorisation token for the services"
      }
    ],
    "extra_imports": [
      {
        "import_url": "github.com/ARM-software/embedded-development-services-client/client",
        "import_ref": "client"
      },
      {
        "import_url": "github.com/Arm-Debug/solar-pack-project-importer/importer/project",
        "import_ref": "project"
      }
    ]
  }
}
