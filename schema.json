{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDK",
  "description": "SDK definition",
  "type": "object",
  "properties": {
    "specification": {
      "description": "The SDK root specification",
      "type": "object",
      "required": [
        "package_name",
        "main_module",
        "interface",
        "global_configuration"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "description": "The package name for the main SDK module"
        },
        "main_module": {
          "type": "string",
          "description": "The module within the package e.g. sdk within Arm-Debug/test/sdk for a go project"
        },
        "name": {
          "type": "string",
          "description": "The name of the SDK to expose (used for the interface and its implementations)"
        },
        "description": {
          "type": "string",
          "description": "The description of the SDK"
        },
        "conf_file": {
          "type": "string",
          "description": "An optional configuration file that will be used to load values from (in addtion to cli args and env vars)"
        },
        "additional_types": {
          "$ref": "#/$defs/types"
        },
        "interface": {
          "$ref": "#/$defs/interface"
        },
        "command_line_commands": {
          "$ref": "#/$defs/command_line_commands"
        },
        "global_configuration": {
          "$ref": "#/$defs/configuration"
        },
        "extra_imports": {
          "$ref": "#/$defs/extra_imports"
        },
        "ci_extra_packages": {
          "$ref": "#/$defs/ci_extra_packages"
        },
        "release_to_artifactory": {
          "$ref": "#/$defs/release_to_artifactory"
        }
      }
    }
  },
  "$defs": {
    "types": {
      "type": "array",
      "description": "A set of entities to export",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "type": {
      "description": "A entity type",
      "type": "object",
      "required": [
        "name",
        "description",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the entity"
        },
        "description": {
          "type": "string",
          "description": "The description of the entity"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_field"
          }
        }
      }
    },
    "interface": {
      "description": "An interface",
      "type": "object",
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface_method"
          }
        }
      },
      "additionalProperties": false
    },
    "command_line_commands": {
      "description": "A CLI command",
      "type": "object",
      "required": [
        "functions"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "description": "Name of the executable"
        },
        "root_environment_var": {
          "type": "string",
          "description": "Environment variable prefix"
        },
        "description": {
          "type": "string",
          "description": "The description of the CLI binary"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cli_function"
          }
        }
      },
      "additionalProperties": false
    },
    "interface_method": {
      "description": "An interface method",
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the field"
        },
        "description": {
          "type": "string",
          "description": "The description of the field"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command_argument"
          }
        },
        "returns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command_argument"
          }
        }
      },
      "additionalProperties": false
    },
    "extra_imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extra_import"
      }
    },
    "ci_extra_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_to_artifactory": {
      "type": "boolean",
      "default": false,
      "description": "Whether to release the package to artifactory. Will require a .goreleaser file or equivalent file to be set up"
    },
    "cli_function": {
      "description": "An CLI function",
      "type": "object",
      "required": [
        "name",
        "description",
        "configuration"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the field"
        },
        "description": {
          "type": "string",
          "description": "The description of the field"
        },
        "configuration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function_config_fields"
          }
        }
      },
      "additionalProperties": false
    },
    "function_config_fields": {
      "allOf": [ 
        { "required": [
            "name",
            "lang_type",
            "mapstructure_tag",
            "bindings",
            "description"
        ]},
        { "$ref": "#/$defs/parameter" } 
      ]
    },
    "command_argument": {
      "allOf": [ 
        { "required": [
            "name",
            "lang_type",
            "description"
        ]},
        { "$ref": "#/$defs/parameter" } 
      ]
    },
    "entity_field": {
      "allOf": [ 
        { "required": [
            "name",
            "lang_type",
            "json_tag",
            "description"
        ]},
        { "$ref": "#/$defs/parameter" } 
      ]
    },
    "parameter": {
      "description": "A command argument or code parameter",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the field"
        },
        "lang_type": {
          "type": "string",
          "description": "The language type for the field"
        },
        "json_tag": {
          "type": "string",
          "description": "The JSON tag of the field"
        },
        "mapstructure_tag": {
          "type": "string",
          "description": "The mapstructure tag of the field"
        },
        "pattern": {
          "type": "string",
          "description": "The pattern that the field should follow if it is a string"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the configuration value is required"
        },
        "reference": {
          "type": "boolean",
          "default": false,
          "description": "Whether the value is a pointer"
        },
        "default_value": {
          "type": "string",
          "description": "An optional default value for use when creating a new instance of the configuration"
        },
        "bindings": {
          "type": "array",
          "description": "Bind congifuration options to variables",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "description": {
          "type": "string",
          "description": "The description of the field"
        },
        "is_root": {
          "type": "boolean",
          "description": "Whether the variable should be in the root command so it can be shared between sub commands",
          "default": false
        }
      },
      "additionalProperties": false
     },
     "binding": {
      "description": "A variable binding to a parameter",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the field"
        },
        "arg": {
          "type": "string",
          "description": "The argument to bind to"
        },
        "mapstructure_tag": {
          "type": "string",
          "description": "The tag fragment used when building the environment variable key"
        },
        "lang_type": {
          "type": "string",
          "description": "The type for the field"
        },
        "description": {
          "type": "string",
          "description": "The description of the field"
        }
      },
      "additionalProperties": false
    },
     "extra_import": {
      "description": "An extra import",
      "type": "object",
      "properties": {
        "import_url": {
          "type": "string",
          "description": "The import URL"
        },
        "import_ref": {
          "type": "string",
          "description": "The reference to use when referencing the import"
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "array",
      "description": "The configuration options for the exported implementation",
      "items": {
        "$ref": "#/$defs/configuration_option"
      }
    },
    "configuration_option": {
      "allOf": [ 
        { "required": [
            "name",
            "lang_type",
            "mapstructure_tag",
            "description",
            "is_root"
        ]},
        { "$ref": "#/$defs/parameter" } 
      ]
    }
  },
  "required": [
    "specification"
  ],
  "additionalProperties": false
}
