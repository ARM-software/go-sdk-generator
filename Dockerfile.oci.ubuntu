# Code generated by our bespoke codegen `go-sdk-generator` (0.45.0).

# OCI runtime image for running go-sdk-generator from released Ubuntu packages in CI and other container-first workflows.
FROM ubuntu:26.04

LABEL org.opencontainers.image.source="https://github.com/Arm-Debug/go-sdk-generator"
LABEL org.opencontainers.image.title="SDK Generator"
LABEL org.opencontainers.image.description="OCI image for running go-sdk-generator in CI and reproducible containerised workflows."
LABEL org.opencontainers.image.documentation="https://github.com/Arm-Debug/go-sdk-generator"
LABEL org.opencontainers.image.licenses="Proprietary"

ARG TARGETPLATFORM

COPY $TARGETPLATFORM/*.deb /tmp/

RUN apt-get update && \
    apt-get install -y ca-certificates curl jq yq /tmp/*.deb && \
    rm -f /tmp/*.deb && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system tool && \
    useradd --system --gid tool --create-home --home-dir /home/tool tool

USER tool

ENTRYPOINT ["go-sdk-generator"]
