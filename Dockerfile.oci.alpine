# Code generated by our bespoke codegen `go-sdk-generator` (0.47.0).

# OCI runtime image for running go-sdk-generator from released Alpine packages in CI and other container-first workflows.
FROM alpine:3.24.3

LABEL org.opencontainers.image.source="https://github.com/ARM-software/go-sdk-generator"
LABEL org.opencontainers.image.title="SDK Generator"
LABEL org.opencontainers.image.description="OCI image for running go-sdk-generator in CI and reproducible containerised workflows."
LABEL org.opencontainers.image.documentation="https://github.com/ARM-software/go-sdk-generator"
LABEL org.opencontainers.image.licenses="Apache-2.0"

ARG TARGETPLATFORM

COPY $TARGETPLATFORM/*.apk /tmp/

RUN apk add --no-cache jq yq curl && \
    apk add --allow-untrusted --no-cache /tmp/*.apk && \
    rm -f /tmp/*.apk && \
    addgroup -S tool && \
    adduser -S -G tool tool

USER tool

ENTRYPOINT ["go-sdk-generator"]
